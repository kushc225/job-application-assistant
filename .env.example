# Gemini Developer API: server-side key only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required in production. Set these to the Cloudflare Access application details.
# Example team domain: your-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAIL=

# Local development only; never enable this for a deployment.
CF_ACCESS_LOCAL_DEV_BYPASS=false
