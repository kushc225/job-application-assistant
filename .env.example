# Gemini Developer API: server-side key only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Store these as Cloudflare Worker secrets. Use a strong random password and
# generate AUTH_SECRET with: openssl rand -base64 32
APP_USERNAME=
APP_PASSWORD=
AUTH_SECRET=

# Gmail sending: create an OAuth 2.0 Web application in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=

# Local development only; never enable this for a deployment.
AUTH_LOCAL_DEV_BYPASS=false
