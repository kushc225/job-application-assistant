# Gemini Developer API: server-side key only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth credentials. The authorized redirect URI is:
# https://<your-worker>.<your-account>.workers.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ALLOWED_EMAIL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Local development only; never enable this for a deployment.
AUTH_LOCAL_DEV_BYPASS=false
