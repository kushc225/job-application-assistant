{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-application-assistant",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "82481931",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "GENERATION_RATE_LIMITER",
      "namespace_id": "82481932",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "GMAIL_SEND_RATE_LIMITER",
      "namespace_id": "82481933",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GMAIL_TOKENS",
      "id": "265d5a72b9634f8c88ee239d133b647d"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "job-application-assistant"
    }
  ]
}
